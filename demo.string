package vinod;

class Parent {
    private String a;

    public String getA() {
        return a;
    }

    public void setA(String a) {
        this.a = a;
    }
}

class Demo extends Parent {
    public static void main(String[] args) {
        Demo bb = new Demo();

        bb.setA("Hello");

        String ss = bb.getA();

        System.out.println(ss);
    }
}
